{
  "name": "wnba-courtside",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data": "python3 scripts/build_data.py ./data/csv ./src/data",
    "bio": "python3 scripts/wikidata_bio.py ./data/csv/dim_players.csv ./data/csv/dim_player_bio.csv",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run data && npm run build && npm run smoke",
    "sync": "npm run build && npx cap sync android",
    "android": "npm run sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.4",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
